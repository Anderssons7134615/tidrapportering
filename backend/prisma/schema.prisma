generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrationPermission {
  READ_ONLY
  MATERIAL_CREATE
  PROJECT_CREATE
}

model Company {
  id        String   @id @default(uuid())
  name      String
  orgNumber String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  customers  Customer[]
  projects   Project[]
  activities Activity[]
  settings           Settings[]
  materialArticles  MaterialArticle[]
  integrationAccessKeys IntegrationAccessKey[]
  integrationMaterialOperations IntegrationMaterialOperation[]
  integrationProjectCreateOperations IntegrationProjectCreateOperation[]
  obsidianSyncEvents ObsidianSyncEvent[]
  projectUpdates     ProjectUpdate[]
}

model User {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  email      String   @unique
  password   String
  name       String
  role       String   @default("EMPLOYEE")
  hourlyCost Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  timeEntries       TimeEntry[]
  approvedEntries   TimeEntry[]        @relation("Approver")
  weekLocks         WeekLock[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  projectMaterials  ProjectMaterial[]
  projectUpdates    ProjectUpdate[]

  @@index([companyId, active])
}

model IntegrationAccessKey {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String   @unique
  active    Boolean  @default(true)
  permission IntegrationPermission @default(READ_ONLY)
  createdAt DateTime @default(now())
  revokedAt DateTime?

  projectAccess      IntegrationProjectAccess[]
  materialOperations IntegrationMaterialOperation[]
  projectCreateOperations IntegrationProjectCreateOperation[]

  @@index([companyId, active])
}

model IntegrationProjectAccess {
  integrationAccessKeyId String
  integrationAccessKey   IntegrationAccessKey @relation(fields: [integrationAccessKeyId], references: [id], onDelete: Cascade)
  projectId              String
  project                Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())

  @@id([integrationAccessKeyId, projectId])
  @@index([projectId])
}

model IntegrationMaterialOperation {
  id                     String @id @default(uuid())
  companyId              String
  company                Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  integrationAccessKeyId String
  integrationAccessKey   IntegrationAccessKey @relation(fields: [integrationAccessKeyId], references: [id], onDelete: Restrict)
  projectId              String
  project                Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  idempotencyKey         String
  payloadHash            String
  status                 String @default("COMPLETED")
  rowCount               Int
  createdAt              DateTime @default(now())

  materials ProjectMaterial[]

  @@unique([integrationAccessKeyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([projectId, createdAt])
}

model IntegrationProjectCreateOperation {
  id                     String @id @default(uuid())
  companyId              String
  company                Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  integrationAccessKeyId String
  integrationAccessKey   IntegrationAccessKey @relation(fields: [integrationAccessKeyId], references: [id], onDelete: Restrict)
  projectId              String @unique
  project                Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  idempotencyKey         String
  payloadHash            String
  status                 String @default("COMPLETED")
  createdAt              DateTime @default(now())

  @@unique([integrationAccessKeyId, idempotencyKey])
  @@index([companyId, createdAt])
}

model PushSubscription {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint        String    @unique
  p256dh          String
  auth            String
  userAgent       String?
  contentEncoding String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  failureReason   String?
}

model Customer {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  orgNumber     String?
  address       String?
  contactPerson String?
  email         String?
  phone         String?
  defaultRate   Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

model Project {
  id                    String    @id @default(uuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id])
  name                  String
  code                  String
  site                  String?
  status                String    @default("PLANNED")
  budgetHours           Float?
  fixedPrice            Float?
  billingModel          String    @default("HOURLY")
  defaultRate           Float?
  employeeCanSeeResults Boolean   @default(false)
  notes                 String?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  timeEntries       TimeEntry[]
  projectMaterials  ProjectMaterial[]
  updates           ProjectUpdate[]
  integrationAccess IntegrationProjectAccess[]
  integrationMaterialOperations IntegrationMaterialOperation[]
  integrationProjectCreateOperation IntegrationProjectCreateOperation?

  @@unique([companyId, code])
}

model ProjectUpdate {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  type              String
  content           String
  occurredAt        DateTime
  source            String   @default("TIDAPP")
  createdByUserId   String?
  createdByUser     User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  idempotencyKey    String
  payloadHash       String
  createdAt         DateTime @default(now())

  @@unique([companyId, source, idempotencyKey])
  @@index([companyId, projectId, occurredAt])
  @@index([projectId, createdAt])
}

model MaterialArticle {
  id                    String    @id @default(uuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  name                  String
  articleNumber         String?
  category              String    @default("Övrigt")
  unit                  String    @default("st")
  supplier              String?
  manufacturer          String?
  originalDescription   String?
  productFamily         String?
  pipeDimensionMm       Float?
  insulationThicknessMm Float?
  outerDiameterMm       Float?
  listPrice             Float?
  discountPercent       Float?
  purchasePrice         Float?
  defaultUnitPrice      Float?
  markupPercent         Float?
  priceSource           String?
  priceUpdatedAt        DateTime?
  searchTerms           String?
  employeeVisible       Boolean   @default(true)
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  projectMaterials ProjectMaterial[]

  @@index([companyId, active])
  @@index([companyId, category, active])
  @@index([companyId, articleNumber])
}

model ProjectMaterial {
  id               String          @id @default(uuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  articleId        String
  article          MaterialArticle @relation(fields: [articleId], references: [id])
  createdByUserId  String?
  createdByUser    User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  articleName      String
  articleNumber    String?
  unit             String
  purchasePrice    Float?
  unitPrice        Float?
  quantity         Float
  date             DateTime
  note             String?
  invoiceStatus    String          @default("UNINVOICED")
  invoicedAt       DateTime?
  invoiceReference String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  integrationOperationId String?
  integrationOperation IntegrationMaterialOperation? @relation(fields: [integrationOperationId], references: [id], onDelete: SetNull)
  integrationRowIndex Int?

  @@index([projectId, date])
  @@index([createdByUserId])
  @@index([integrationOperationId])
  @@unique([integrationOperationId, integrationRowIndex])
}

model Activity {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  code            String
  category        String   @default("WORK")
  billableDefault Boolean  @default(true)
  rateOverride    Float?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  timeEntries TimeEntry[]

  @@unique([companyId, code])
}

model TimeEntry {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  activityId  String
  activity    Activity  @relation(fields: [activityId], references: [id])
  date        DateTime
  startTime   String?
  endTime     String?
  hours       Float
  billable    Boolean   @default(true)
  note        String?
  status      String    @default("DRAFT")
  submittedAt DateTime?
  approvedAt  DateTime?
  approverId  String?
  approver    User?     @relation("Approver", fields: [approverId], references: [id])
  rejectNote  String?
  invoiceStatus String   @default("UNINVOICED")
  invoicedAt DateTime?
  invoiceReference String?
  gpsLat      Float?
  gpsLng      Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attachments Attachment[]

  @@index([userId, date])
  @@index([projectId, date])
  @@index([status, date])
}

model Attachment {
  id           String    @id @default(uuid())
  timeEntryId  String
  timeEntry    TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime  @default(now())
}

model WeekLock {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  weekStartDate DateTime
  status        String    @default("SUBMITTED")
  comment       String?
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewerId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, weekStartDate])
  @@index([status, weekStartDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model ObsidianSyncEvent {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId   String?
  entityType  String
  entityId    String?
  action      String
  eventType   String
  payload     Json?
  ackedAt     DateTime?
  ackedBy     String?
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, ackedAt, createdAt])
  @@index([projectId])
}

model Settings {
  id              String   @id @default(uuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id])
  companyName     String   @default("Mitt Företag AB")
  vatRate         Float    @default(25)
  weekStartDay    Int      @default(1)
  csvDelimiter    String   @default(";")
  defaultCurrency String   @default("SEK")
  reminderTime    String   @default("15:30")
  reminderEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
